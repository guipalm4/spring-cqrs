    {
      "name": "Consultas (dataset seedado)",
      "description": "Usam a conta empresarial `businessAccountId` (seed-b-0000001). Troque por `retailAccountId` para uma conta de pessoa física. Exigem `make seed` com o salt padrão (42).",
      "item": [
        {
          "name": "Q1 — Conta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{businessAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{businessAccountId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Q2 — Extrato (primeira página)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const next = pm.response.json().nextCursor;",
                  "pm.collectionVariables.set('cursor', next ?? '');",
                  "console.log('cursor salvo:', next ?? '(última página)');",
                  "pm.test('cursor salvo na collection', () => pm.expect(pm.collectionVariables.get('cursor')).to.eql(next ?? ''));",
                  "if (pm.variables.get('cursor') !== pm.collectionVariables.get('cursor'))",
                  "    console.warn('Há uma variável cursor em outro escopo (environment ou global) sobrepondo a da collection.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{businessAccountId}}/statement?from=2026-01-01T00:00:00Z&to=2026-10-01T00:00:00Z&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{businessAccountId}}",
                "statement"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-10-01T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Período [from, to), mais recentes primeiro. Guarda `nextCursor` em `cursor`."
          }
        },
        {
          "name": "Q2 — Extrato (próxima página)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('cursor')) throw new Error('cursor vazio: rode a primeira página antes (ou a página anterior foi a última).');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const next = pm.response.json().nextCursor;",
                  "pm.collectionVariables.set('cursor', next ?? '');",
                  "console.log('cursor salvo:', next ?? '(última página)');",
                  "pm.test('cursor salvo na collection', () => pm.expect(pm.collectionVariables.get('cursor')).to.eql(next ?? ''));",
                  "if (pm.variables.get('cursor') !== pm.collectionVariables.get('cursor'))",
                  "    console.warn('Há uma variável cursor em outro escopo (environment ou global) sobrepondo a da collection.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{businessAccountId}}/statement?from=2026-01-01T00:00:00Z&to=2026-10-01T00:00:00Z&limit=50&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{businessAccountId}}",
                "statement"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-10-01T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            },
            "description": "Usa o cursor da página anterior; o período e o limit precisam ser os mesmos."
          }
        },
