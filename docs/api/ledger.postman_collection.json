{
  "info": {
    "name": "spring-cqrs — Ledger API",
    "description": "Endpoints do contrato v1 (`docs/api/openapi.json`). Suba com `make up PHASE=v1`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Comandos",
      "description": "Fluxo encadeado: rode a pasta em ordem (Runner) ou request a request. Valores em centavos. Cada request gera uma Idempotency-Key nova, exceto os de reenvio, que reaproveitam a do depósito.",
      "item": [
        {
          "name": "Abrir conta A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountId', pm.response.json().accountId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderId\": \"postman-{{$guid}}\",\n  \"holderName\": \"Ana Postman\",\n  \"currency\": \"BRL\",\n  \"overdraftLimit\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "description": "201 + Location. Guarda o id em `accountId`."
          }
        },
