      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"ledger\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=\"ledger\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"ledger\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
