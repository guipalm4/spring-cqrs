          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{application=~\"$application\", area=\"heap\"})",
          "legendFormat": "máximo"
        }
      ]
    },
    {
      "id": 10,
